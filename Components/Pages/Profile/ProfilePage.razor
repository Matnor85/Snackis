@page "/profile/{UserId}"
@* AI-assisterad (info-sida om sig själv + egen idé: vägg):
   Visar en användares profil med bild, namn, "Medlem sedan" och texten om sig själv.
   Under profilen finns personens vägg där inloggade kan skriva inlägg och kommentera. *@
@if (loading)
{
    <p>Laddar...</p>
}
else if (profile is null)
{
    <p>Användaren finns inte.</p>
}
else
{
    <PageTitle>@profile.DisplayName - Snackis</PageTitle>

    <div class="mx-auto" style="max-width:680px">
        @* Profilkortet *@
        <div class="card mb-4 shadow-sm">
            <div class="card-body text-center">
                <div class="d-flex justify-content-center mb-3">
                    <Avatar ImagePath="@profile.ProfileImagePath" Name="@profile.DisplayName" Size="120" />
                </div>
                <h2 class="mb-0">@profile.DisplayName</h2>
                <small class="text-muted">Medlem sedan @profile.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</small>

                @if (!string.IsNullOrWhiteSpace(profile.Bio))
                {
                    <p class="mt-3 mb-0" style="white-space:pre-wrap">@profile.Bio</p>
                }

                <div class="mt-3">
                    @if (IsOwnProfile)
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="profile/edit">Redigera profil</a>
                    }
                    else if (currentUserId is not null)
                    {
                        <a class="btn btn-primary btn-sm" href="messages/@profile.Id">Skicka meddelande</a>
                    }
                </div>
            </div>
        </div>

        @* Skriv på väggen *@
        @if (currentUserId is not null)
        {
            <PostComposer UserId="@currentUserId" ProfileOwnerId="@profile.Id"
                          Placeholder="@(IsOwnProfile ? "Vad vill du dela?" : $"Skriv något till {profile.DisplayName}...")"
                          OnPosted="LoadWallAsync" />
        }

        @* Väggen *@
        <h5 class="mb-3">Inlägg</h5>

        @if (!wall.Any())
        {
            <p class="text-muted">Inga inlägg än.</p>
        }

        @foreach (var post in wall)
        {
            <FeedPostCard @key="post.Id" Post="post" CurrentUserId="@currentUserId" IsAdmin="isAdmin"
                          OnComment="AddComment" OnDelete="DeletePost" />
        }
    </div>
}

