@page "/messages/{OtherUserId}"
@attribute [Authorize]
@using System.Security.Claims


<PageTitle>Meddelanden - Snackis</PageTitle>

<nav class="mb-2"><a href="messages">Alla meddelanden</a></nav>

@if (loading)
{
    <p>Laddar...</p>
}
else if (otherUser is null)
{
    <p>Användaren finns inte.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@otherUser.DisplayName</h1>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">Uppdatera</button>
    </div>

    <div class="border rounded p-3 mb-3 bg-light" style="min-height:300px">
        @if (!messages.Any())
        {
            <p class="text-muted text-center">Inga meddelanden än. Säg hej!</p>
        }

        @foreach (var m in messages)
        {
            var isMine = m.SenderId == userId;
            <div class="d-flex mb-2 @(isMine ? "justify-content-end" : "justify-content-start")">
                <div class="px-3 py-2 rounded-3 @(isMine ? "bg-primary text-white" : "bg-white border")"
                     style="max-width:70%">
                    <div style="white-space:pre-wrap">@m.Content</div>
                    <small class="@(isMine ? "text-white-50" : "text-muted")">
                        @m.SentAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        @if (isMine && m.IsRead)
                        {
                            <text> · Läst</text>
                        }
                    </small>
                </div>
            </div>
        }
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="input-group">
        <textarea class="form-control" rows="2" @bind="newMessage"
                  placeholder="Skriv ett meddelande..."></textarea>
        <button class="btn btn-primary" @onclick="Send">Skicka</button>
    </div>
}